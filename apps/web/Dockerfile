FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_NAME
ARG NEXT_PUBLIC_SUPPORT_ENABLED
ARG NEXT_PUBLIC_SUPPORT_WECHAT_QR_URL
ARG NEXT_PUBLIC_SUPPORT_ALIPAY_QR_URL
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME
ENV NEXT_PUBLIC_SUPPORT_ENABLED=$NEXT_PUBLIC_SUPPORT_ENABLED
ENV NEXT_PUBLIC_SUPPORT_WECHAT_QR_URL=$NEXT_PUBLIC_SUPPORT_WECHAT_QR_URL
ENV NEXT_PUBLIC_SUPPORT_ALIPAY_QR_URL=$NEXT_PUBLIC_SUPPORT_ALIPAY_QR_URL
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
EXPOSE 3000
USER node
CMD ["node", "server.js"]
