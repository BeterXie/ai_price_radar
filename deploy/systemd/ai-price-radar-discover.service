[Unit]
Description=AI Price Radar discover public shops
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-price-radar-v3
ExecStart=/usr/bin/bash /opt/ai-price-radar-v3/scripts/refresh_remote.sh discover
ExecStopPost=-/usr/bin/docker rm -f ai-price-radar-crawler-run-discover
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
