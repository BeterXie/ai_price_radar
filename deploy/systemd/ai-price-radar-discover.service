[Unit]
Description=AI Price Memory discover public shops
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-price-radar-v3
EnvironmentFile=-/opt/ai-price-radar-v3/.env
ExecStart=/usr/bin/bash /opt/ai-price-radar-v3/scripts/refresh_remote.sh discover
ExecStopPost=-/usr/bin/docker rm -f ai-price-radar-crawler-run-discover
NoNewPrivileges=true
Nice=10
IOSchedulingClass=idle
CPUQuota=85%
MemoryMax=1000M
TimeoutStartSec=2h

# 可选降权：见 docs/QUICK_DEPLOY.md「systemd 降权」一节。
#User=pricememo
#Group=pricememo
