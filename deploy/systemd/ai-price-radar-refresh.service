[Unit]
Description=AI Price Radar scan and publish
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-price-radar-v3
ExecStart=/usr/bin/bash /opt/ai-price-radar-v3/scripts/refresh_remote.sh scan
ExecStopPost=-/usr/bin/docker rm -f ai-price-radar-crawler-run-scan
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4h
