ai.pricememo.cn {
    encode zstd gzip

    @internal path /api/v1/internal/*
    handle @internal {
        respond 404
    }

    @api path /api/* /docs* /openapi.json /health
    handle @api {
        request_body {
            max_size 1MB
        }
        reverse_proxy ai-radar-api:8000 {
            lb_try_duration 5s
            lb_try_interval 200ms
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                keepalive 300s
                keepalive_idle_conns 100
            }
        }
    }

    @demos path /demos/*
    handle @demos {
        header {
            -X-Frame-Options
            Content-Security-Policy "frame-ancestors 'self'"
            Cache-Control "no-cache, must-revalidate"
        }
        reverse_proxy ai-radar-web:3000 {
            lb_try_duration 5s
            lb_try_interval 200ms
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                keepalive 300s
                keepalive_idle_conns 100
            }
        }
    }

    handle {
        reverse_proxy ai-radar-web:3000 {
            lb_try_duration 5s
            lb_try_interval 200ms
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
                keepalive 300s
                keepalive_idle_conns 100
            }
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
            }
        }
    }
}
