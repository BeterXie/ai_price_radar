{$SITE_ADDRESS} {
    encode zstd gzip

    @api path /api/* /docs* /openapi.json /health
    handle @api {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:3000
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
