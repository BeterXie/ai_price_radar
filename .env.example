# Database
POSTGRES_DB=price_radar
POSTGRES_USER=price_radar
POSTGRES_PASSWORD=change-me-now
DATABASE_URL=postgresql+psycopg://price_radar:change-me-now@db:5432/price_radar
POSTGRES_PORT=5432

# API
API_PORT=8000
ADMIN_API_KEY=replace-with-at-least-32-random-bytes
WEB_ORIGIN=http://localhost:3000
SEED_DEMO_DATA=false
PUBLIC_SITE_URL=http://localhost:3000
REPORT_RATE_LIMIT_COUNT=5
REPORT_RATE_LIMIT_WINDOW_SECONDS=3600
TRUSTED_PROXY_CIDRS=172.16.0.0/12
SHOP_INTAKE_ADMIN_EMAILS=admin@example.invalid
INTAKE_WORKER_KEY=replace-with-a-separate-intake-worker-key
DETECTOR_WORKER_KEY=replace-with-a-separate-detector-worker-key
DISCOVERY_WORKER_KEY=replace-with-a-separate-discovery-worker-key

# Source discovery
DISCOVERY_ENABLED=true
DISCOVERY_SOURCES=seed,16688,commoncrawl,bing,github
DISCOVERY_16688_SOURCE_PAGES=3
DISCOVERY_API_URL=http://api:8000
DISCOVERY_DUJIAO_SOURCES=seed,bing,github
DISCOVERY_MAX_RAW_URLS=2000
DISCOVERY_MAX_NEW_CANDIDATES=1000
DISCOVERY_MAX_PROCESSED_CANDIDATES=3000
DISCOVERY_REVERIFY_STALE_HOURS=24
DISCOVERY_REQUEST_INTERVAL_SECONDS=2
DISCOVERY_BING_PAGES=5
DISCOVERY_BING_COUNT=30
DISCOVERY_BING_DELAY_SECONDS=2
DISCOVERY_GITHUB_PAGES=3
DISCOVERY_GITHUB_COUNT=100
DISCOVERY_GITHUB_MAX_CANDIDATES=300
DISCOVERY_COMMONCRAWL_INDEXES=2
DISCOVERY_COMMONCRAWL_MAX_URLS=500
DISCOVERY_DUJIAO_AUTO_APPROVE=true
DISCOVERY_WOOCOMMERCE_AUTO_APPROVE=true
DISCOVERY_SCHEMA_AUTO_APPROVE=false
DISCOVERY_MERCHANT_AUTO_APPROVE=false
DISCOVERY_16688_AUTO_APPROVE=false
# Optional GitHub API token; empty means anonymous low-frequency search. Only sent to api.github.com.
GITHUB_TOKEN=

# Resend API (preferred for production; replace this placeholder with your real key)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=onboarding@resend.dev
# SMTP fallback (used by the local Mailpit setup)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
INTAKE_API_URL=http://api:8000

# Web
WEB_PORT=3000
INTERNAL_API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_NAME=AI Price Radar
NEXT_PUBLIC_SUPPORT_ENABLED=true
NEXT_PUBLIC_SUPPORT_WECHAT_QR_URL=https://ai.pricememo.cn/support/wechat.jpg
NEXT_PUBLIC_SUPPORT_ALIPAY_QR_URL=https://ai.pricememo.cn/support/alipay.jpg

# Production reverse proxy (set to the public domain to enable automatic HTTPS)
SITE_ADDRESS=http://localhost
